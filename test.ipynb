      "text/html": [
       "<div class=\"alert alert-info\" style=\"border-radius: 10px; position: relative; padding: 24px 32px 20px 32px; margin-top: 25px; border: 4px solid #31708f; max-width: 420px; margin-left: auto; margin-right: auto;\">\n",
       "  <span style=\"position: absolute; top: -28px; left: 16px; background-color: #31708f; color: white; border-radius: 50%; width: 56px; height: 56px; display: inline-flex; align-items: center; justify-content: center; font-size: 28px;\">\n",
       "    <i class=\"fa fa-lock\"></i>\n",
       "  </span>\n",
       "  <div style=\"text-align:center; margin-bottom:16px;\">\n",
       "    <h3 style=\"color:#31708f; margin:0 0 6px 0;\">🔐 Zugang zum Serverraum</h3>\n",
       "    <p style=\"margin:0; color:#31708f; font-size:14px;\">\n",
       "      Gebt das Codewort ein, um die Tür zu öffnen:\n",
       "    </p>\n",
       "  </div>\n",
       "  <hr style=\"border:none; border-top:1px solid #31708f; opacity:0.3; margin-bottom:16px;\">\n",
       "  <div style=\"display:flex; flex-direction:column; align-items:center; gap:10px;\">\n",
       "    <input id=\"pw3-input\" type=\"password\" placeholder=\"Codewort eingeben …\" style=\"border:1.5px solid #31708f; border-radius:6px; padding:7px 12px; font-size:14px; width:280px; outline:none; background:white;\">\n",
       "    <div style=\"display:flex; align-items:center; gap:8px;\">\n",
       "      <input type=\"checkbox\" id=\"pw3-show\" style=\"cursor:pointer;\">\n",
       "      <label for=\"pw3-show\" style=\"color:#31708f; font-size:13px; cursor:pointer;\">Passwort anzeigen</label>\n",
       "    </div>\n",
       "    <button id=\"pw3-btn\" style=\"background-color:#31708f; color:white; border:none; border-radius:6px; padding:9px 28px; font-weight:bold; font-size:14px; cursor:pointer; letter-spacing:0.3px;\">Bestätigen</button>\n",
       "    <p id=\"pw3-feedback\" style=\"margin:0; font-weight:bold; font-size:15px; text-align:center;\"></p>\n",
       "  </div>\n",
       "  <div id=\"pw3-nav\" style=\"display:none; margin-top:16px; text-align:center;\">\n",
       "    <a href=\"story_game_2.ipynb\" style=\"display:inline-block; padding:10px 24px; border-radius:8px; border:3px solid #31708f; background-color:#beeaf1; color:#31708f; text-decoration:none; font-weight:bold; box-shadow:0 2px 6px rgba(0,0,0,0.15);\">In den Serverraum &nbsp;<i class=\"fa fa-arrow-right\"></i></a>\n",
       "  </div>\n",
       "</div>\n",
       "\n",
       "<script>\n",
       "setTimeout(function() {\n",
       "  var accepted = [\n",
       "    \"TWFjaGluZUxlYXJuaW5n\",\n",
       "    \"TWFjaGluZSBMZWFybmluZw==\",\n",
       "    \"TWFjaGluZS1MZWFybmluZw==\",\n",
       "    \"bWFjaGluZWxlYXJuaW5n\",\n",
       "    \"bWFjaGluZSBsZWFybmluZw==\",\n",
       "    \"bWFjaGluZS1sZWFybmluZw==\",\n",
       "    \"TUFDSElORUxFQVJOSU5H\",\n",
       "    \"TUFDSElORSBMRUFSTklORw==\",\n",
       "    \"TUFDSElORS1MRUFSTklORw==\",\n",
       "    \"TWFjaGluZSBsZWFybmluZw==\"\n",
       "  ];\n",
       "\n",
       "  var input = document.getElementById(\"pw3-input\");\n",
       "  var btn = document.getElementById(\"pw3-btn\");\n",
       "  var showCb = document.getElementById(\"pw3-show\");\n",
       "  var feedback = document.getElementById(\"pw3-feedback\");\n",
       "  var nav = document.getElementById(\"pw3-nav\");\n",
       "\n",
       "  showCb.addEventListener(\"change\", function() {\n",
       "    input.type = this.checked ? \"text\" : \"password\";\n",
       "  });\n",
       "\n",
       "  function checkPassword() {\n",
       "    var encoded = btoa(unescape(encodeURIComponent(input.value)));\n",
       "    if (accepted.includes(encoded)) {\n",
       "      feedback.style.color = \"#3c763d\";\n",
       "      feedback.textContent = \"✅ Passwort korrekt! Zugriff gewährt.\";\n",
       "      nav.style.display = \"block\";\n",
       "    } else {\n",
       "      feedback.style.color = \"#a94442\";\n",
       "      feedback.textContent = \"❌ Falsches Passwort! Zugriff verweigert.\";\n",
       "      nav.style.display = \"none\";\n",
       "    }\n",
       "  }\n",
       "\n",
       "  btn.onclick = checkPassword;\n",
       "  input.addEventListener(\"keydown\", function(e) {\n",
       "    if (e.key === \"Enter\") checkPassword();\n",
       "  });\n",
       "}, 100);\n",
       "</script>\n"
      ],
